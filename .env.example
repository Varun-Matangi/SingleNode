# Copy this file to .env.local and fill in real values.
# Not secrets — just public site content. On your hosting platform
# (Cloudflare Pages, etc.), set these in the project's environment
# variables settings instead of committing them here.

NEXT_PUBLIC_SITE_EMAIL=hello@singlenodestudio.com
NEXT_PUBLIC_SITE_PHONE=+1 (555) 018-2947

# Your real deployed domain, e.g. https://singlenodestudio.com or the
# *.pages.dev URL Cloudflare gives you before you attach a custom domain.
NEXT_PUBLIC_SITE_URL=https://singlenodestudio.com
