# Copy this file to .dev.vars and fill in your real n8n webhook URL + secret.
# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser.
# In production these are set via:
#   wrangler secret put N8N_WEBHOOK_URL
#   wrangler secret put N8N_WEBHOOK_SECRET

N8N_WEBHOOK_URL=https://n8n.singlenodestudio.com/webhook/contact-form
N8N_WEBHOOK_SECRET=
