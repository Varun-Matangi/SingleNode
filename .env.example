# Copy this file to .env.local and fill in real values.
# Not secrets — just public site content. On your hosting platform
# (Cloudflare Pages, etc.), set these in the project's environment
# variables settings instead of committing them here.

NEXT_PUBLIC_SITE_EMAIL=hello@singlenodestudio.com
NEXT_PUBLIC_SITE_PHONE=+1 (555) 018-2947

# Your real deployed domain, e.g. https://singlenodestudio.com or the
# *.pages.dev URL Cloudflare gives you before you attach a custom domain.
NEXT_PUBLIC_SITE_URL=https://singlenodestudio.com

# Server-only — do NOT prefix with NEXT_PUBLIC_, this must never reach the
# browser bundle. The contact form's API route (app/api/contact/route.ts)
# forwards submissions to this n8n webhook URL. Set it locally via
# .dev.vars (see .dev.vars.example) and in production via:
#   wrangler secret put N8N_WEBHOOK_URL
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/contact-form

# Server-only — shared secret sent as the X-Webhook-Secret header so n8n can
# reject requests that don't come from this app (the webhook URL alone isn't
# secret). Must match the Header Auth credential on the n8n Webhook node.
# Set via: wrangler secret put N8N_WEBHOOK_SECRET
# N8N_WEBHOOK_SECRET=
